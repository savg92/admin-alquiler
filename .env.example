# Copy to .env for local development. Never commit .env (see .gitignore).
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=admin_alquiler
POSTGRES_USER=admin_alquiler
POSTGRES_PASSWORD=change-me-in-dev

# API / worker
DATABASE_URL=postgresql://admin_alquiler:change-me-in-dev@localhost:5432/admin_alquiler
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000

# MinIO (local dev only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-dev-123

# Auth (required in production, min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-in-production-123456

# Ports
API_PORT=3001
WEB_PORT=3000
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# AI (Phase 2 — all optional, default off; the platform is fully usable without them)
# Master switch. When false the gateway returns a graceful non-AI path for every call.
AI_ENABLED=false
# Browser WebGPU inference. Clients must also report WebGPU support per call.
AI_WEBGPU_ENABLED=false
# Comma-separated local model ids, most preferred first. Enables the local runtime.
AI_LOCAL_MODELS=
AI_LOCAL_BASE_URL=http://localhost:8080
# External provider adapter. Empty means "not configured" and never contacted.
AI_EXTERNAL_PROVIDER=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# Decision model for `decide`: laya = self-hosted default, jev = optional hosted adapter.
AI_DECISION_PROVIDER=laya
AI_DECISION_BASE_URL=http://localhost:8090
AI_DECISION_MODEL=laya
AI_DECISION_API_KEY=
