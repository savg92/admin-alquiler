{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "types": ["bun-types"],
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@admin-alquiler/auth": ["./packages/auth/src/index.ts"],
      "@admin-alquiler/config": ["./packages/config/src/index.ts"],
      "@admin-alquiler/database": ["./packages/database/src/index.ts"],
      "@admin-alquiler/documents": ["./packages/documents/src/index.ts"],
      "@admin-alquiler/domain": ["./packages/domain/src/index.ts"],
      "@admin-alquiler/events": ["./packages/events/src/index.ts"],
      "@admin-alquiler/notifications": [
        "./packages/notifications/src/index.ts"
      ],
      "@admin-alquiler/permissions": ["./packages/permissions/src/index.ts"],
      "@admin-alquiler/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
