:80 {
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }

  # Liveness and readiness live at the root, not under /api, so they need their own
  # rules. Without these they fall through to the SPA and answer 404.
  handle /health {
    reverse_proxy api:3001
  }

  handle /ready {
    reverse_proxy api:3001
  }

  handle /api/* {
    reverse_proxy api:3001
  }

  # Everything else is the SPA. Mutually exclusive handle blocks keep the API routes
  # from depending on where `try_files` happens to sort.
  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}
