:80 {
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }

  # Liveness and readiness live at the root, not under /api, so they need their own
  # rules. Without these they fall through to the SPA and answer 404.
  handle /health {
    reverse_proxy api:3001
  }

  handle /ready {
    reverse_proxy api:3001
  }

  handle /api/* {
    reverse_proxy api:3001
  }

  # Everything else is the SPA. It is proxied rather than served from disk because
  # the built assets live in the web image, not in this container.
  handle {
    reverse_proxy web:80
  }
}
