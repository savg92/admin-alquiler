{
  "name": "admin-alquiler",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, mobile-first, multi-organization property and rental administration platform (Colombia first, es-CO).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:api": "bun run --filter '@admin-alquiler/api' dev",
    "dev:web": "bun run --filter '@admin-alquiler/web' dev",
    "dev:worker": "bun run --filter '@admin-alquiler/worker' dev",
    "build": "bun run --filter './apps/*' build",
    "lint": "eslint . && prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\"",
    "lint:fix": "eslint --fix . && prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test apps/api/test apps/worker/test",
    "test:e2e": "bun test apps/api/e2e",
    "test:security": "bun test apps/api/test/security.* tests/security",
    "check": "bun run lint && bun run typecheck && bun test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "bun-types": "1.4.2",
    "eslint": "^9.15.0",
    "husky": "9.1.7",
    "prettier": "^3.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
