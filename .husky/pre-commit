STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mts|cts|mjs|cjs|json|jsonc)$' || true)
if [ -n "$STAGED_TS" ]; then
  echo "$STAGED_TS" | xargs bunx eslint
  echo "$STAGED_TS" | xargs bunx prettier --check
else
  echo "lint: no JS/TS files staged, skipping"
fi
bunx tsc --noEmit -p tsconfig.json
